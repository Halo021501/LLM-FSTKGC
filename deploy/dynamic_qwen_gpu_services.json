{
  "schema_version": 2,
  "model": "Qwen2.5-7B-Instruct-AWQ",
  "model_directory": "models/Qwen2.5-7B-Instruct-AWQ",
  "runtime": "configure with QWEN_PYTHON",
  "existing_service": {
    "gpu_id": 2,
    "endpoint": "http://127.0.0.1:8000/v1",
    "managed_by_pool": false
  },
  "dynamic_services": [
    {"gpu_id": 0, "port": 8100, "state_subdirectory": "servers/gpu0"},
    {"gpu_id": 1, "port": 8101, "state_subdirectory": "servers/gpu1"},
    {"gpu_id": 3, "port": 8103, "state_subdirectory": "servers/gpu3"},
    {"gpu_id": 4, "port": 8104, "state_subdirectory": "servers/gpu4"},
    {"gpu_id": 5, "port": 8105, "state_subdirectory": "servers/gpu5"},
    {"gpu_id": 6, "port": 8106, "state_subdirectory": "servers/gpu6"}
  ],
  "serving_profile": {
    "quantization": "awq_marlin",
    "max_model_len": 2048,
    "gpu_memory_utilization": 0.5,
    "max_num_seqs": 4,
    "enforce_eager": true,
    "frontend_multiprocessing": false,
    "guided_decoding_backend": "lm-format-enforcer"
  },
  "generation_profile": {
    "compact_wire_keys": true,
    "rationale_word_limit": 8,
    "initial_max_tokens": 512,
    "single_retry_max_tokens": 768,
    "minimum_local_request_timeout_seconds": 360,
    "reason_for_512": "The 320/384 formal attempt produced repeated length-truncated JSON; the cap was raised without changing the prompt, schema, or maximum candidate count.",
    "task_retry_policy": {
      "maximum_attempts_per_shard": 3,
      "initial_backoff_seconds": 30,
      "backoff_multiplier": 2,
      "resume_durable_records": true,
      "attempts_are_audited_in_sqlite": true
    }
  },
  "idle_admission": {
    "additional_gpu_requires_zero_compute_processes": true,
    "minimum_free_memory_mib": 12000,
    "maximum_gpu_utilization_percent": 5,
    "consecutive_checks": 2,
    "poll_seconds": 10,
    "parallel_server_startup": true,
    "retry_failed_server_start_after_seconds": 120,
    "monitor_initial_gpus_that_were_busy_at_controller_start": true
  },
  "initial_gpu_admission": {
    "gpu_ids": [2, 3, 4, 5],
    "minimum_free_memory_mib": 9500,
    "gpu_2_existing_service_is_adopted": true,
    "gpu_3_gpu_4_and_gpu_5_are_managed_by_pool": true,
    "gpu_4_shared_mode_explicitly_authorized": true
  }
}
