    "CONFIRM_ALIYUN_QWEN_DATA_UPLOAD=YES",
    "CONFIRM_ALIYUN_QWEN_PAID_BATCH=YES"
  ],
  "explicit_execute_api_flag_required": true,
  "remote_deletion_requires_additional_confirmation": "CONFIRM_ALIYUN_QWEN_REMOTE_DELETE=YES",
  "external_api_called_during_extension_build": false,
  "created_at": "2026-08-09",
