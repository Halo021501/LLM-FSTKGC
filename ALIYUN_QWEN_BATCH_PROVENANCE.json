{
  "extension": "aliyun_qwen_batch",
  "parent_variant": "1.7.0alterego_v5_llm",
  "scope": "optional offline STLP cache provider; no model, training, or evaluation-path replacement",
  "formal_task_book_primary_provider_unchanged": true,
  "formal_task_book_primary_provider": "local Qwen2.5-7B-Instruct-AWQ",
