# Copy to .env.qwen_local only when overriding these local-only defaults.
# No API credential is required and the client rejects non-loopback URLs.
LOCAL_QWEN_MODEL_DIR=models/Qwen2.5-7B-Instruct-AWQ
LOCAL_QWEN_MODEL=Qwen2.5-7B-Instruct-AWQ
LOCAL_QWEN_BASE_URL=http://127.0.0.1:8000/v1

# A completely idle RTX 4060 Ti is required by default.
LOCAL_QWEN_GPU_ID=0
LOCAL_QWEN_PORT=8000
LOCAL_QWEN_MAX_MODEL_LEN=4096
LOCAL_QWEN_GPU_MEMORY_UTILIZATION=0.70
LOCAL_QWEN_MAX_NUM_SEQS=16

# Shared mode is opt-in. If enabled, lower the model budget and keep a strict
# free-memory floor; eager execution avoids CUDA Graph reservation overhead.
ALLOW_SHARED_GPU=NO
LOCAL_QWEN_MIN_FREE_MIB=9500
LOCAL_QWEN_ENFORCE_EAGER=NO
LOCAL_QWEN_DISABLE_FRONTEND_MULTIPROCESSING=YES
LOCAL_QWEN_GUIDED_DECODING_BACKEND=lm-format-enforcer
LOCAL_QWEN_QUANTIZATION=awq_marlin

# Keep NO until the test/validation cache generation plan has been reviewed.
CONFIRM_LOCAL_QWEN_GENERATION=NO
INCLUDE_VALID=NO
