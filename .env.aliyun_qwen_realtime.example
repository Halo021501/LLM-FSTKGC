# The realtime wrapper reuses the same DASHSCOPE_API_KEY as the Batch setup.
# Keep the real file mode 600 and never commit or paste the key into a command.
DASHSCOPE_API_KEY=
ALIYUN_QWEN_REALTIME_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_QWEN_REALTIME_MODEL=qwen-flash

# Both values must be YES before any realtime prompt is uploaded or billed.
CONFIRM_ALIYUN_QWEN_DATA_UPLOAD=NO
CONFIRM_ALIYUN_QWEN_PAID_REALTIME=NO

# Conservative aggregate defaults. The wrapper divides these between shot5
# and shot10 so both can run together without independently consuming the cap.
# Optional overrides. If omitted, the wrapper uses scope-aware profiles:
# smoke=8/240 RPM/300K TPM, pilot=16/480/600K, full=32/960/1.2M.
# ALIYUN_QWEN_REALTIME_WORKERS=8
# ALIYUN_QWEN_REALTIME_MAX_RPM=240
# ALIYUN_QWEN_REALTIME_MAX_TPM=300000
ALIYUN_QWEN_REALTIME_TOKEN_RESERVATION=1200
ALIYUN_QWEN_REALTIME_MAX_ATTEMPTS=5
# Main-consumer heartbeat while all bounded worker requests await responses.
ALIYUN_QWEN_REALTIME_HEARTBEAT_SECONDS=30
