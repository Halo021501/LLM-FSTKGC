# Copy this file to .env.aliyun_qwen_batch only after the offline batch plan
# has been reviewed. Never commit or paste the real key into source, logs,
# prompts, reports, or shell command-line arguments.
DASHSCOPE_API_KEY=
ALIYUN_QWEN_BATCH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# The dated model is the reproducible default for paper experiments.
ALIYUN_QWEN_BATCH_MODEL=qwen3.7-flash-2026-07-15
ALIYUN_QWEN_BATCH_COMPLETION_WINDOW=24h

# The moving qwen-flash alias may have a lower current input price, but its
# behavior can change without a project change. Use it only as an explicitly
# named rolling-cost comparison, never as the default paper condition.
# ALIYUN_QWEN_BATCH_MODEL=qwen-flash

# Both confirmations must be YES before the wrapper permits any upload,
# submission, status query, download, or other external API operation.
CONFIRM_ALIYUN_QWEN_DATA_UPLOAD=NO
CONFIRM_ALIYUN_QWEN_PAID_BATCH=NO

# Remote-file deletion is destructive and has a separate third confirmation.
# Leave NO until local outputs and their hashes have been verified.
CONFIRM_ALIYUN_QWEN_REMOTE_DELETE=NO

# Test-only caches are sufficient for the frozen-v5 comparison. Set YES only
# after the test pilot passes and LLM-aware validation/from-scratch training is
# authorized.
INCLUDE_VALID=NO
